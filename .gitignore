# Derived artefacts — regenerate with `python scripts/train.py`
data/cache/                    # 245 MB of rendered tensors; pure cache
models/checkpoint.keras        # resumable-training scratch
models/best.keras              # ditto
models/train_state.json        # ditto

# NOTE what is deliberately NOT ignored:
#   models/fallguard_cnn.npz    the app cannot run without it (0.8 MB)
#   models/labels.json          serving metadata
#   models/fallguard_cnn.keras  archival Keras copy (2.4 MB)
#   reports/*                   evaluation evidence for the submission
#   data/fallguard_dataset.npz  the corpus itself (6.7 MB) — keeps results reproducible

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.DS_Store
*.mp4
!assets/*.mp4
.streamlit/secrets.toml
